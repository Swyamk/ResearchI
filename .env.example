# =============================================================================
# NutriMind – Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=NutriMind
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production  # development | staging | production

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=nutrimind
POSTGRES_PASSWORD=nutrimind_secure_password
POSTGRES_DB=nutrimind_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nutrimind:nutrimind_secure_password@postgres:5432/nutrimind_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379/0
REDIS_CACHE_TTL=3600  # seconds

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# ── USDA FoodData Central ─────────────────────────────────────────────────────
USDA_API_KEY=your-usda-api-key-from-fdc.nal.usda.gov
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# ── OpenFoodFacts ─────────────────────────────────────────────────────────────
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/api/v2
OPENFOODFACTS_USER_AGENT=NutriMind/1.0 (contact@nutrimind.app)

# ── Indian Food Composition ───────────────────────────────────────────────────
INDIAN_FCD_PATH=./datasets/indian_fcd/ifct2017.csv

# ── AI Models ─────────────────────────────────────────────────────────────────
AI_MODELS_HOST=ai_models
AI_MODELS_PORT=8001
AI_MODELS_URL=http://ai_models:8001
MODEL_WEIGHTS_DIR=./ai_models/weights
YOLO_MODEL_PATH=./ai_models/weights/yolov8_food.pt
SAM2_MODEL_PATH=./ai_models/weights/sam2_hiera_large.pt
EFFICIENTNET_MODEL_PATH=./ai_models/weights/efficientnetv2_food256.pth
MIDAS_MODEL_PATH=./ai_models/weights/midas_v31_large.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
CLASSIFICATION_TOP_K=5

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://nutrimind.app

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10

# ── Email (Optional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@nutrimind.app

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO

# ── PgAdmin (Dev Only) ────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@nutrimind.app
PGADMIN_PASSWORD=admin_password

# ── Next.js Public Vars ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=NutriMind
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
